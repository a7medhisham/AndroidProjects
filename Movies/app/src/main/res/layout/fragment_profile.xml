<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_marginTop="8dp"
            android:id="@+id/tvTitle"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile"
            android:layout_gravity="center"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_personal"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"
            app:strokeColor="@color/black"
            app:strokeWidth="2dp" />

        <TextView
            android:layout_margin="10dp"
            android:id="@+id/labelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/name"
            android:textSize="25sp"
            android:layout_gravity="center"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/labelEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/email"
            android:layout_gravity="center"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logout_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:elevation="4dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/be_light"
                android:textColor="@color/black"
                android:backgroundTint="#115A95"
                android:layout_marginTop="30dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toBottomOf="@+id/imgQr"
                app:layout_constraintStart_toStartOf="@+id/imgQr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete_account"
                android:elevation="4dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/be_light"
                android:textColor="@color/black"
                android:backgroundTint="#115A95"
                android:layout_marginTop="30dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toBottomOf="@+id/logout_btn"
                app:layout_constraintStart_toStartOf="@+id/logout_btn" />
    </LinearLayout>
</ScrollView>
