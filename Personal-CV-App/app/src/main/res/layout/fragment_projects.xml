<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:textSize="24sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_movies_title"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#FCE4EC"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_movies_tech"
            android:padding="10dp"
            android:background="#F3E5F5"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_movies_desc1"
            android:padding="10dp"
            android:background="#EDE7F6"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_movies_desc2"
            android:padding="10dp"
            android:background="#E8EAF6"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:textSize="24sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_news_title"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#E3F2FD"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_news_tech"
            android:padding="10dp"
            android:background="#E1F5FE"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_news_desc"
            android:padding="10dp"
            android:background="#E0F7FA"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:textSize="24sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_kids_title"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#E8F5E9"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_kids_tech"
            android:padding="10dp"
            android:background="#F1F8E9"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_kids_desc"
            android:padding="10dp"
            android:background="#F9FBE7"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:textSize="24sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_web_title"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#FFF3E0"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_web_tech"
            android:padding="10dp"
            android:background="#FFF8E1"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_web_desc"
            android:padding="10dp"
            android:background="#FFFDE7"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:textSize="24sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/skills_databases_title"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#EFEBE9"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_db_desc"
            android:padding="10dp"
            android:background="#FAFAFA"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/project_db_tech"
            android:padding="10dp"
            android:background="#ECEFF1"/>

    </LinearLayout>
</ScrollView>
